{
  "name": "marketplace_anomaly_detect_daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      },
      "id": "c3873802-2a09-4739-b091-2d52bb6eb1e3",
      "name": "Schedule quotidien",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -656,
        112
      ],
      "disabled": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH last_day AS (SELECT max(dt) AS dt FROM analytics.daily_summary), moy AS (SELECT AVG(total_revenue) AS avg7 FROM analytics.daily_summary WHERE dt >= (SELECT dt FROM last_day) - 7 AND dt < (SELECT dt FROM last_day)) SELECT s.dt, s.total_revenue, ROUND(moy.avg7, 2) AS avg7, ROUND(s.total_revenue / NULLIF(moy.avg7, 0), 3) AS ratio FROM analytics.daily_summary s, moy, last_day l WHERE s.dt = l.dt;",
        "options": {}
      },
      "id": "665acc61-1c3f-48b4-abe0-a3c2db887d1b",
      "name": "CA vs moyenne 7j",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "NcxYzwC2SQ1rNqMp",
          "name": "Postgres account"
        }
      },
      "notes": "ratio = CA du dernier jour / moyenne mobile des 7 jours precedents."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-ratio",
              "leftValue": "={{ $json.ratio.toNumber() }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            },
            {
              "id": "1998ac6d-d5d5-4507-99fe-0b9c7504ecd4",
              "leftValue": "={{ $json.ratio }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "569cae44-3538-442d-9ac2-8f38eb30ae13",
      "name": "CA < 70% moyenne ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        112
      ],
      "notes": "US-05 : alerte si le CA du jour < 70% de la moyenne sur 7 jours."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO analytics.alerts (dt, alert_type, message)\nVALUES (\n  '{{ $json.dt.toDateTime().toFormat(\"yyyy-MM-dd\") }}',\n  'CA_DROP',\n  'CA {{ $json.total_revenue }} EUR = {{ $json.ratio }} x moyenne 7j ({{ $json.avg7 }} EUR)'\n);",
        "options": {}
      },
